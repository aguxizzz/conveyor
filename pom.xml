<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator for the conveyor modules. Versions of every Spring and third-party dependency come from the
  Spring Boot parent, so the modules below only name what they use.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>dev.aguxis</groupId>
	<artifactId>conveyor-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>conveyor-parent</name>
	<description>Postgres-backed job queue</description>

	<modules>
		<!-- the queue itself: no Spring Boot, usable from any app that has a DataSource -->
		<module>conveyor-core</module>
		<!-- auto-configuration, so a Spring Boot app only adds the dependency -->
		<module>conveyor-spring-boot-starter</module>
		<!-- standalone service: REST API and dashboard on top of the starter -->
		<module>conveyor-server</module>
	</modules>

	<properties>
		<java.version>17</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>dev.aguxis</groupId>
				<artifactId>conveyor-core</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>dev.aguxis</groupId>
				<artifactId>conveyor-spring-boot-starter</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
